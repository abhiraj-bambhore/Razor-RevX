# Gemini API Key (get free at https://aistudio.google.com/app/apikey)
# Leave blank to use deterministic fallback — system works fully without it
GEMINI_API_KEY=

# Razorpay Test Mode Keys (optional — system simulates API calls if not set)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Simulation mode: set to "true" to skip all real API calls
SIMULATE_MODE=true
